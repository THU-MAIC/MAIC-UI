# Playwright E2E configuration for WebEditor
# Copy to .env.e2e and adjust values

# Frontend base URL (Playwright baseURL)
BASE_URL=http://localhost:3000

# API base used by the tests (nginx proxy in docker-compose.dev.yml)
E2E_API_URL=http://localhost:8927/api

# Private user credentials (for private web/PPT flows)
E2E_PRIVATE_EMAIL=your_private_user@example.com
E2E_PRIVATE_PASSWORD=your_password

# Document IDs for testing (must exist in backend DB)
E2E_PRIVATE_WEB_DOC_ID=123
E2E_PUBLIC_WEB_DOC_ID=456
E2E_PRIVATE_PPT_DOC_ID=789
E2E_PUBLIC_PPT_DOC_ID=1011

# Slide number for PPT demo (must point to a demo slide with demo_html)
E2E_PPT_DEMO_SLIDE=1
